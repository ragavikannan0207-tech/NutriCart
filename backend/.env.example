# NutriCart backend environment variables.
# Copy this file to `.env` in the same directory (backend/) and adjust for your machine.
# `.env` is gitignored; never commit real values.

# MySQL connection
NUTRICART_DB_URL=jdbc:mysql://localhost:3306/nutricart?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
NUTRICART_DB_USER=your_mysql_user
NUTRICART_DB_PASSWORD=your_mysql_password

# JWT signing secret (HS256, at least 32 bytes / 256 bits). Replace with a strong, unique value in production.
NUTRICART_JWT_SECRET=replace_with_a_strong_secret_at_least_32_bytes
NUTRICART_JWT_MINUTES=1440

# CORS origins (comma-separated)
NUTRICART_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
