# ---------------------------------------------------------------
# NutriCart frontend environment
# Copy this file to `.env.local` and adjust for your machine.
# ---------------------------------------------------------------

# Base URL of the Java Spring Boot REST API.
# Leave empty to use the Vite dev-server proxy (/api -> http://localhost:8080)
VITE_API_BASE_URL=

# Data layer mode:
#   auto   -> probe the Spring Boot backend; fall back to the browser
#             persistence layer when the backend is unreachable (default)
#   api    -> always use Spring Boot (errors surface if the backend is down)
#   local  -> always use the browser persistence layer (offline demo mode)
VITE_DATA_MODE=auto

# Timeout (ms) for the backend health probe used by `auto` mode
VITE_API_PROBE_TIMEOUT=1500
